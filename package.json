{
  "name": "studynotion-workspace",
  "version": "1.0.0",
  "description": "Clean workspace for StudyNotion",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "frontend": "npm start --prefix frontend",
    "backend": "npm run dev --prefix backend",
    "dev": "concurrently -n \"frontend,backend\" -c \"bgBlue,bgYellow\" \"npm run frontend\" \"npm run backend\""
  },
  "dependencies": {
    "concurrently": "^9.2.0"
  }
}
