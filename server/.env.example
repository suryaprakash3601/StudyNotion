## Backend environment variables
## Copy to `server/.env` to enable external services.

PORT=4000

# MongoDB (if not set, server starts but DB-backed APIs will fail)
DB_URL=

# CORS origins (comma-separated). If empty, defaults to localhost + production domain.
# CORS_ORIGIN=http://localhost:3000,https://mega-ed-tech.vercel.app

# Cloudinary (optional; if missing, uploads will not work)
CLOUD_NAME=
API_KEY=
API_SECRET=

